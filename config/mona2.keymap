#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */
#include <behaviors/runtime_macro.dtsi>
/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100


/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* ─────────────────────────────────────────────────────────────
       コンボ (DYA Studio から編集可能)

       旧 `combos { compatible = "zmk,combos"; }` はコンパイル時固定で
       DYA Studio から編集できないため、zmk-feature-runtime-combo の
       「コンパイル時デフォルト」ノードへ移行した。
       ここに書いた内容はフラッシュ直後から有効で、設定を消しても復活する。
       DYA Studio 側で編集するとそのスロットだけ上書きされ、
       Web UI の "Reset to Default" でここの値へ戻せる。

       スロット総数は CONFIG_ZMK_RUNTIME_COMBO_MAX_COMBOS (現状 16)。
       未使用スロット (2〜15) は DYA Studio から自由に追加できる。
       ────────────────────────────────────────────────────────── */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        /* S + D 同時押しで Tab */
        tab {
            slot = <0>;
            display-name = "Tab";
            key-positions = <11 12>;
            bindings = <&kp TAB>;
        };

        /* K + L 同時押しの間だけスクロールレイヤー (9) */
        scroll {
            slot = <1>;
            display-name = "scroll";
            key-positions = <18 19>;
            bindings = <&mo 9>;
        };

        /* I + O 同時押しの間だけマウスジェスチャー (Mouse Gesture Key 0) */
        gesture {
            slot = <2>;
            display-name = "gesture";
            key-positions = <7 8>;
            bindings = <&mg_set_0>;
        };

        /* スロット3 (旧 BLE) は本体で削除済み。BLE レイヤーへは
           Space を押したまま左親指の内側 (SYM の 38 番 = &mo 11) で入る */
    };

    /* 静的マクロ (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };



        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        /* ベースレイヤー用の矢印キー。DYA Studio 上の表記は cw=← / ccw=→ だが、
           実機ではつまみを右に回すと→、左に回すと←になる (2026-10-03 本人確認) */
        rsr_base: rsr_base {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp LEFT_ARROW>;
            ccw-binding = <&kp RIGHT_ARROW>;
        };

        /* NAV 用のなめらかなズーム。右に回すと F19、左に回すと F18 を送り、
           moNa Overlay (~/Projects/mona-overlay) がピンチのズーム (F19=拡大・F18=縮小) に変える。
           アプリを終了している間は何も起きない */
        rsr_nav: rsr_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp F18>;
            ccw-binding = <&kp F19>;
        };

        /* L4 用の一段ずつのズーム。右に回すと ⌘+ (⌘⇧=)、左に回すと ⌘− */
        rsr_l4: rsr_l4 {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp LG(MINUS)>;
            ccw-binding = <&kp LG(PLUS)>;
        };


        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    /* ─────────────────────────────────────────────────────────────
       レイヤー構成 (番号 = DYA Studio の表示順)
         0 BASE     1 SYM (Space長押し)  2 NUM (-親指長押し)  3 NAV (Bksp長押し)
         Space を押したまま左親指の内側 (SYM の 38 番) を押している間は 11 BLE
         左親指の内側を押したまま Space (NUM の 39 番) を押している間は 4 L4 (ウィンドウ)
         4 L4 = Rectangle のショートカット (⌃⌥ / ⌃⌥⌘) を送るウィンドウ操作。5〜8 空き
         8 L8 (空き)        9 SCROLL   10 MOUSE   11 BLE
       ※ 番号は mona2_r.overlay の scroll の active-layers (レイヤー9) と
          mouse の temp-layer (レイヤー10) が位置で参照している。
          レイヤーを途中に挿入したら両方を合わせて直すこと。
       ────────────────────────────────────────────────────────── */
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
&mt LCTRL A  &kp S  &kp D  &kp F  &kp G  &kp C_VOL_UP  &kp H  &kp J  &kp K  &kp L  &mt RCTRL ENTER
&mt LSHFT Z  &kp X  &kp C  &kp V  &kp B  &kp SEMI  &kp C_VOL_DN  &kp N  &kp M  &kp COMMA  &kp DOT  &mt RSHFT SLASH
&gresc  &kp LALT  &kp LCTRL  &lt 3 BSPC  &mt LGUI LANG2  &lt 2 MINUS  &lt 1 SPACE  &mt RGUI LANG1  &kp RA(DOT)
            >;

            sensor-bindings = <&rsr_base>, <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* 記号。右親指 (Space) の長押し */
        sym_layer {
            display-name = "SYM";
            bindings = <
&kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
&kp GRAVE  &kp TILDE  &kp LBRC  &kp RBRC  &kp PIPE  &kp C_BRI_UP  &kp BSLH  &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC
&kp LT  &kp GT  &kp EQUAL  &kp PLUS  &kp UNDER  &trans  &kp C_BRI_DN  &kp MINUS  &kp LBKT  &kp RBKT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mo 11  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 数字。左親指の内側 (-) の長押し。左手がテンキー (最下段に 0 と .、Z の位置は Caps Lock)、右手が F1〜F15
           Space の位置 (39 番) は L4 へ (左親指の内側を押したまま Space) */
        num_layer {
            display-name = "NUM";
            bindings = <
&kp MINUS  &kp N7  &kp N8  &kp N9  &kp PLUS  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15
&kp SLASH  &kp N4  &kp N5  &kp N6  &kp STAR  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp CAPS  &kp N1  &kp N2  &kp N3  &kp EQUAL  &kp SLASH  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &kp N0  &kp DOT  &trans  &trans  &trans  &mo 4  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 移動。左親指の外側 (Bksp) の長押し。右手が矢印・単語/行/ページ移動・タブ切替 (左手は空き)。つまみはなめらかなズーム */
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp PG_UP  &kp LA(LEFT)  &kp UP  &kp LA(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LG(RIGHT)
&trans  &trans  &trans  &trans  &trans  &trans  &kp DEL  &kp PG_DN  &kp LC(LS(TAB))  &kp LC(TAB)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_nav>;
        };

        /* ウィンドウ操作 (Rectangle の既存ショートカットを送る)。左手は幅、右手は上下の位置と画面移動
             上段 Q〜R: 1/4 の①〜④      Y/P: 左上・右上 1/4   U/I/O: 上段 1/6 の左・中・右
             中段 A/G: 左・右 3/4  S/F: 左・右半分  D: 最大化   H/⏎位置: 前・次の画面  K: 中央
             下段 Z/B: 左・右 2/3  X/C/V: 1/3 の左・中・右     N//: 左下・右下 1/4   M/,/.: 下段 1/6
             右手内側の上下 2 キー (15/27): 上半分・下半分。つまみは一段ずつのズーム (⌘− / ⌘+) */
        spare4_layer {
            display-name = "L4";
            bindings = <
&kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))  &kp LC(LA(N4))  &trans  &kp LC(LA(U))  &kp LC(LA(O))  &kp LC(LA(P))  &kp LC(LA(LBKT))  &kp LC(LA(I))
&kp LC(LA(W))  &kp LC(LA(LEFT))  &kp LC(LA(ENTER))  &kp LC(LA(RIGHT))  &kp LC(LA(R))  &kp LC(LA(UP))  &kp LC(LA(LG(LEFT)))  &trans  &kp LC(LA(C))  &trans  &kp LC(LA(LG(RIGHT)))
&kp LC(LA(E))  &kp LC(LA(D))  &kp LC(LA(F))  &kp LC(LA(G))  &kp LC(LA(T))  &trans  &kp LC(LA(DOWN))  &kp LC(LA(J))  &kp LC(LA(L))  &kp LC(LA(SEMI))  &kp LC(LA(SQT))  &kp LC(LA(K))
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_l4>;
        };

        /* 空き */
        spare5_layer {
            display-name = "L5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare6_layer {
            display-name = "L6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare7_layer {
            display-name = "L7";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare8_layer {
            display-name = "L8";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* このレイヤーの間はボールがスクロール (overlay の active-layers) */
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* オートマウス (overlay の temp-layer) */
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB3  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans  &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* Bluetooth。Space を押したまま左親指の内側で入る
             右手 上段 Y〜P: BT_SEL 0〜4 (0=Mac, 1=iPad)   中段 H〜⏎位置: BT_DISC 0〜4 (選ぶキーの真下で切断)
             右手 /: BT_CLR (今の番号だけ消す)   H の左: OUT_TOG   N の左: 右手の bootloader
             左手 Q: BT_CLR_ALL   T: studio_unlock   B の右: 左手の bootloader (押した側の半分が書き込みモード) */
        ble_layer {
            display-name = "BLE";
            bindings = <
&bt BT_CLR_ALL  &trans  &trans  &trans  &studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &out OUT_TOG  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4
&trans  &trans  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };
    };
};
