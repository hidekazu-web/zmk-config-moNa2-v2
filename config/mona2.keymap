#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */
#include <behaviors/runtime_macro.dtsi>
/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100


/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* ─────────────────────────────────────────────────────────────
       コンボ (DYA Studio から編集可能)

       旧 `combos { compatible = "zmk,combos"; }` はコンパイル時固定で
       DYA Studio から編集できないため、zmk-feature-runtime-combo の
       「コンパイル時デフォルト」ノードへ移行した。
       ここに書いた内容はフラッシュ直後から有効で、設定を消しても復活する。
       DYA Studio 側で編集するとそのスロットだけ上書きされ、
       Web UI の "Reset to Default" でここの値へ戻せる。

       スロット総数は CONFIG_ZMK_RUNTIME_COMBO_MAX_COMBOS (現状 16)。
       未使用スロット (2〜15) は DYA Studio から自由に追加できる。
       ────────────────────────────────────────────────────────── */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        tab {
            slot = <0>;
            display-name = "Tab";
            key-positions = <11 12>;
            bindings = <&kp TAB>;
        };

        /* K + L 同時押しの間だけスクロールレイヤー (9) */
        scroll {
            slot = <1>;
            display-name = "scroll";
            key-positions = <18 19>;
            bindings = <&mo 9>;
        };

        /* I + O 同時押しの間だけマウスジェスチャー (Mouse Gesture Key 0) */
        gesture {
            slot = <2>;
            display-name = "gesture";
            key-positions = <7 8>;
            bindings = <&mg_set_0>;
        };

        /* Bksp親指 + Space親指 の同時押しの間だけ BLE (11) */
        ble {
            slot = <3>;
            display-name = "BLE";
            key-positions = <36 39>;
            bindings = <&mo 11>;
        };
    };

    /* 静的マクロ (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };



        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        /* ベースレイヤー用の矢印キー。DYA Studio 上の表記は cw=← / ccw=→ だが、
           実機ではつまみを右に回すと→、左に回すと←になる (2026-10-03 本人確認) */
        rsr_base: rsr_base {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp LEFT_ARROW>;
            ccw-binding = <&kp RIGHT_ARROW>;
        };


        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    /* ─────────────────────────────────────────────────────────────
       レイヤー構成 (番号 = DYA Studio の表示順)
         0 BASE     1 SYM (Space長押し)  2 NUM (Bksp長押し)  3 NAV (-親指長押し)
         Bksp親指 + Space親指の同時押し (コンボ) の間は 11 BLE
         4〜7 空き
         8 GESTURE (空き)   9 SCROLL   10 MOUSE   11 BLE
       ※ 番号は mona2_r.overlay の scroll の active-layers (レイヤー9) と
          mouse の temp-layer (レイヤー10) が位置で参照している。
          レイヤーを途中に挿入したら両方を合わせて直すこと。
       ────────────────────────────────────────────────────────── */
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q             &kp W     &kp E    &kp R          &kp T                                                &kp Y      &kp U                &kp I          &kp O    &kp P
&mt LEFT_CONTROL A  &kp S   &kp D    &kp F          &kp G                                &kp MINUS       &kp H      &kp J                &kp K          &kp L    &mt RIGHT_CONTROL ENTER
&mt LEFT_SHIFT Z  &kp X     &kp C    &kp V          &kp B                  &kp SEMICOLON &kp BACKSPACE   &kp N      &kp M                &lt 9 COMMA    &kp DOT  &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LALT  &kp ESC  &lt 2 BACKSPACE  &mt LEFT_GUI LANG2   &lt 3 MINUS   &lt 1 SPACE     &mt RIGHT_GUI LANG1                                     &kp RA(DOT)
            >;

            sensor-bindings = <&rsr_base>, <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* 記号。右親指 (Space) の長押し */
        sym_layer {
            display-name = "SYM";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                          &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR
&kp GRAVE  &kp TILDE  &kp LBRC   &kp RBRC   &kp PIPE              &trans       &kp BSLH   &kp LBKT   &kp RBKT   &kp DQT    &kp SQT
&kp LT     &kp GT     &kp EQUAL  &kp PLUS   &kp UNDER  &trans     &trans       &kp MINUS  &kp SEMI   &kp COLON  &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans       &trans                                       &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 数字。左親指の外側 (Bksp) の長押し。右手がテンキー (右親指が 0)、左手が F1〜F15 */
        num_layer {
            display-name = "NUM";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                          &kp STAR   &kp N7  &kp N8  &kp N9  &kp SLASH
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10             &trans      &kp MINUS  &kp N4  &kp N5  &kp N6  &kp PLUS
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans     &trans      &kp DOT    &kp N1  &kp N2  &kp N3  &kp EQUAL
&trans   &trans   &trans   &trans   &trans   &trans     &kp N0      &trans                              &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 移動。左親指の内側 (-) の長押し。右手が矢印、左手が修飾キーと編集 */
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans       &trans       &trans       &trans       &trans                                &kp PG_UP      &kp LA(LEFT)    &kp UP    &kp LA(RIGHT)  &trans
&kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &trans                   &trans       &kp LG(LEFT)   &kp LEFT        &kp DOWN  &kp RIGHT      &kp LG(RIGHT)
&kp LG(Z)    &kp LG(X)    &kp LG(C)    &kp LG(V)    &kp LG(LS(Z))  &trans    &kp DELETE   &kp PG_DN      &kp LC(LS(TAB)) &kp LC(TAB)  &trans    &trans
&trans       &trans       &trans       &trans       &trans         &trans    &trans       &trans                                                 &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare4_layer {
            display-name = "L4";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare5_layer {
            display-name = "L5";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare6_layer {
            display-name = "L6";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* 空き */
        spare7_layer {
            display-name = "L7";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* ジェスチャー用 (空き)。ジェスチャー本体は I+O のコンボ */
        gesture_layer {
            display-name = "GESTURE";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* このレイヤーの間はボールがスクロール (overlay の active-layers) */
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* オートマウス (overlay の temp-layer) */
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &mkp MB3  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &mkp MB1  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        ble_layer {
            display-name = "BLE";
            bindings = <
&kp F1  &kp F2        &kp F3        &kp F4        &kp F5                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F6  &kp F7        &kp F8        &kp F9        &trans            &out OUT_TOG  &trans        &trans        &trans        &trans        &studio_unlock
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans    &bootloader   &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans    &trans        &bootloader                                             &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_default>;
        };
    };
};
